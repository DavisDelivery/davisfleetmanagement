# No trailing slash: some test dirs symlink node_modules to .uitest/node_modules,
# and a trailing slash matches directories only, so the symlinks would be committed.
node_modules

# Third-party bundles the browser tests serve locally instead of hitting a CDN.
# Fetched on first run by .uitest/vendor.mjs — babel.min.js alone is 2.8 MB.
.uitest/vendor/

# Build artifacts and captured output from test runs.
.uitest2/app.compiled.js
*-output.txt
*.png
*.pdf

# Build output — regenerated by build.mjs on every deploy.
app.build.js
boot.build.js

# Throwaway investigation scaffolding. Root-causing a production bug sometimes means
# driving the real app against a shaped backend to watch the SDK's state machine — those
# probes hardcode absolute scratch paths, are never run by CI, and are not tests. Real
# tests are named for the behaviour they guard and are listed in .github/workflows/checks.yml.
.uitest/probe-*/
.uitest/zz-*.mjs
